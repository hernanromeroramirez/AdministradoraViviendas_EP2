<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.viviendas.controller.MainController">

    <top>
        <VBox prefHeight="85.0" spacing="8.0"
              style="-fx-background-color: #343A40;">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <children>
                <Label text="Administradora de Viviendas"
                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="Sistema de gestión y registro de propiedades"
                       style="-fx-text-fill: #E0E0E0; -fx-font-size: 13px;"/>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-background-color: #FFFFFF;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <children>
                <TitledPane text="Registrar nueva vivienda" expanded="true"
                            animated="false">
                    <content>
                        <GridPane hgap="15" vgap="12"
                                  style="-fx-background-color: #F5F5F5;">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>

                            <columnConstraints>
                                <ColumnConstraints minWidth="180" prefWidth="220"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                            </columnConstraints>

                            <children>
                                <Label text="Tipo de vivienda" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="cmbTipo" prefWidth="220"
                                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Departamento"/>
                                            <String fx:value="Casa"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>

                                <Label text="Código" GridPane.rowIndex="1"/>
                                <TextField fx:id="txtCodigo" promptText="Ej: PROP-D01"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Superficie (m²)" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtSuperficie" promptText="Ej: 65"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Habitaciones" GridPane.rowIndex="3"/>
                                <TextField fx:id="txtHabitaciones" promptText="Ej: 3"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>


                                <!-- Datos exclusivos de Departamento -->
                                <Label fx:id="lblPiso" text="Piso" GridPane.rowIndex="4"
                                       visible="false" managed="false"/>

                                <TextField fx:id="txtPiso" promptText="Ej: 8"
                                           GridPane.columnIndex="1" GridPane.rowIndex="4"
                                           visible="false" managed="false"/>

                                <Label fx:id="lblGastosComunes" text="Gastos comunes pagados"
                                       GridPane.rowIndex="5" visible="false" managed="false"/>

                                <ComboBox fx:id="cmbGastosComunes" prefWidth="220"
                                          GridPane.columnIndex="1" GridPane.rowIndex="5"
                                          visible="false" managed="false">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Sí"/>
                                            <String fx:value="No"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label fx:id="lblEstacionamiento" text="Estacionamiento asignado"
                                       GridPane.rowIndex="6" visible="false" managed="false"/>

                                <ComboBox fx:id="cmbEstacionamiento" prefWidth="220"
                                          GridPane.columnIndex="1" GridPane.rowIndex="6"
                                          visible="false" managed="false">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Sí"/>
                                            <String fx:value="No"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>

                                <!-- Dato exclusivo de Casa -->
                                <Label fx:id="lblPatio" text="¿Tiene patio?"
                                       GridPane.rowIndex="7" visible="false" managed="false"/>

                                <ComboBox fx:id="cmbPatio" prefWidth="220"
                                          GridPane.columnIndex="1" GridPane.rowIndex="7"
                                          visible="false" managed="false">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Sí"/>
                                            <String fx:value="No"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </children>
                        </GridPane>
                    </content>
                </TitledPane>

                <HBox spacing="10">
                    <Button fx:id="btnRegistrar" text="Registrar vivienda"/>
                    <Button fx:id="btnLimpiar" text="Limpiar"/>
                </HBox>

                <Label text="Viviendas registradas"
                       style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

                <TableView fx:id="tablaViviendas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="130"/>
                        <TableColumn fx:id="colSuperficie" text="Superficie (m²)" prefWidth="130"/>
                        <TableColumn fx:id="colHabitaciones" text="Habitaciones" prefWidth="120"/>
                        <TableColumn fx:id="colCosto" text="Costo arriendo" prefWidth="150"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="btnEliminar" text="Eliminar vivienda"/>
                </HBox>

                <Label fx:id="lblMensaje" text="Sistema listo."
                       style="-fx-text-fill: #555555;"/>
            </children>
        </VBox>
    </center>
</BorderPane>
